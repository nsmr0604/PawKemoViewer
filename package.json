{
  "name": "pawkemoviewer",
  "private": true,
  "version": "0.5.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test:platform": "node --test tests/platform.test.mjs",
    "test:application": "node --test tests/application.test.mjs",
    "test:domain": "node --test tests/domain.test.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "build": "npm run check:boundaries && tsc -b && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "icons:generate": "node scripts/generate-icons.mjs",
    "icons:generate:android": "node scripts/app-icon/generate-android.mjs --config src-tauri/app-icons.json",
    "icons:generate:ios": "node scripts/app-icon/generate-ios.mjs --config src-tauri/app-icons.json",
    "tauri:dev": "npm run icons:generate && tauri dev --features debug-diag",
    "tauri:build": "npm run icons:generate && tauri build",
    "tauri:android:dev": "npm run icons:generate && tauri android dev --features debug-diag",
    "build:debug": "npm run check:boundaries && tsc -b && vite build --mode development",
    "sync:version": "node scripts/sync-version.mjs",
    "postversion": "node scripts/sync-version.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.5",
    "i18next": "^27.2.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^18.0.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.9.3",
    "vite": "^6.0.3"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.17.19": true,
    "sharp@0.33.5": true
  }
}
